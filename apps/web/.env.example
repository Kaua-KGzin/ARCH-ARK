# =====================================================
# FIREBASE — Autenticação e Persistência de Dados
# =====================================================
# Obtenha essas credenciais em: https://console.firebase.google.com/project/link-89720/settings/general
# SDK Setup → Config (Web) → copie os valores abaixo

NEXT_PUBLIC_FIREBASE_API_KEY=coloque_sua_api_key_aqui
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=link-89720.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=link-89720
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=link-89720.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=944023340985
NEXT_PUBLIC_FIREBASE_APP_ID=coloque_seu_app_id_aqui

# =====================================================
# ARK AI — Google Gemini (opcional)
# =====================================================
# Copie as chaves acima e adicione a chave do Gemini abaixo.
# Obtenha uma chave gratuita em: https://aistudio.google.com/apikey
#
# Sem a chave, o app funciona normalmente com o motor local (modo offline).
# Com a chave, o ARK ganha chat inteligente, profecias e missões criativas.

GEMINI_API_KEY=coloque_sua_chave_aqui

# Modelo (opcional) — default: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
