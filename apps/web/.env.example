# =====================================================
# SUPABASE — Autenticação e Persistência de Dados
# =====================================================
# Obtenha essas credenciais em: https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque_sua_publishable_key_aqui

# Login com Google (opcional): habilite o provider "Google" em
# Authentication → Providers no dashboard do Supabase e configure o
# redirect URL: https://SEU_DOMINIO/auth/callback

# =====================================================
# ARK AI — Google Gemini (opcional)
# =====================================================
# Obtenha uma chave gratuita em: https://aistudio.google.com/apikey
#
# Sem a chave, o app funciona normalmente com o motor local (modo offline).
# Com a chave, o ARK ganha chat inteligente, profecias e missões criativas.

GEMINI_API_KEY=coloque_sua_chave_aqui

# Modelo (opcional) — default: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
