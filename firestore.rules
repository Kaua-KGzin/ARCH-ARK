rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ===== ESTRUTURA PRINCIPAL: users/{userId} =====
    match /users/{userId} {
      // Leitura/escrita do documento raiz do usuário
      allow read, write: if isOwner(userId);

      // Subcoleção: game-state (estado completo do jogo)
      match /game-state/{document=**} {
        allow read, write: if isOwner(userId);
      }

      // Subcoleção: character (dados do personagem)
      match /character/{document=**} {
        allow read, write: if isOwner(userId);
      }

      // Subcoleção: inventory (itens do inventário)
      match /inventory/{itemId} {
        allow read, write: if isOwner(userId);
      }

      // Subcoleção: missions (missões do usuário)
      match /missions/{missionId} {
        allow read, write: if isOwner(userId);
      }

      // Subcoleção: achievements (conquistas desbloqueadas)
      match /achievements/{achievementId} {
        allow read, write: if isOwner(userId);
      }

      // Subcoleção: skills (habilidades do personagem)
      match /skills/{skillId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Regras para Imagens Geradas por IA / Comunidade
    match /images/{imageId} {
      allow read: if true; // Leitura pública do feed de imagens
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Regras para Galeria de Imagens IA (pública)
    match /ai_gallery/{galleryId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Regra padrão de negação para qualquer outro caminho não especificado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
